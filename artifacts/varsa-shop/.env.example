# Runtime only, read by the built storefront service. Staging uses SEO_INDEXING=0.
# Production needs NODE_ENV=production and the exact matching HTTPS host.
SEO_SITE_URL=https://varsasaffron.ir
SEO_INDEXING=0
STOREFRONT_PORT=5174
STOREFRONT_API_ORIGIN=http://127.0.0.1:5000
# Public business details only; leave blank until confirmed by the site owner.
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_CONTACT_ADDRESS=
# Direct HTTPS public profile/channel URLs; platform homepages are not accepted.
VITE_INSTAGRAM_URL=
VITE_TELEGRAM_URL=
