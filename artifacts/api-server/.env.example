PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/varsa
SESSION_SECRET=replace-with-a-long-random-secret
# 32 random bytes encoded as hex, stored only on the server.
ADMIN_MFA_KEY=
# Local development only: temporary admin codes after password verification.
ADMIN_AUTH_DEV_OTP=false
# Canonical HTTPS storefront origin, without a trailing path. Required in production.
PUBLIC_ORIGIN=
BIND_HOST=127.0.0.1
# Leave empty for direct access. Only list the actual reverse proxy IPs.
# The proxy must overwrite forwarded headers and the API must not be public behind it.
TRUSTED_PROXY_IPS=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Legacy import only. Remove both Supabase variables after successful article import.
PG_POOL_MAX=10
PG_APPLICATION_NAME=varsa-api
ALLOWED_ORIGINS=
# 24 hours for pending manual orders; confirmation stops automatic expiration.
RESERVATION_TTL_SECONDS=86400
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=varsa
S3_ACCESS_KEY_ID=replace-on-server
S3_SECRET_ACCESS_KEY=replace-on-server

# Customer authentication: keep all of these on the API host, never in VITE_*.
# HTTPS adapter accepting {phone,message,purpose,code?,eventId?}; see docs/customer-portal.md.
CUSTOMER_SMS_URL=
CUSTOMER_SMS_TOKEN=
CUSTOMER_AUTH_SECRET=
CUSTOMER_ALLOWED_ORIGINS=
# The production environment always disables development OTP responses.
CUSTOMER_AUTH_DEV_OTP=false
SMS_HOURLY_LIMIT=200
SMS_DAILY_LIMIT=1000
UPLOAD_ACCOUNT_BYTES=104857600
UPLOAD_TOTAL_BYTES=10737418240

# Optional single-host private file storage (otherwise use the S3 settings above).
# Keep this directory outside the public web root; allow only the service user.
# STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=/var/lib/varsa/files
# Explicitly keep SMS unavailable until a real provider is configured.
# CUSTOMER_SMS_DISABLED=true
# Optional operator-only temporary password login; defaults to MFA required.
# ADMIN_PASSWORD_ONLY=true
# Removing this flag immediately rejects sessions issued in password-only mode.

# Manual card transfer: keep disabled until card, bot and worker are verified.
CARD_TRANSFER_ENABLED=false
CARD_TRANSFER_NUMBER=
CARD_TRANSFER_ACCOUNT_NAME=
CARD_TRANSFER_BANK_NAME=
# Create the bot via Bale's official BotFather; secrets stay on the server.
BALE_BOT_TOKEN=
# Use a private chat with the bot. Start it from the operator account first.
BALE_ADMIN_CHAT_ID=
# Comma-separated numeric user IDs allowed to approve/reject receipts.
BALE_ADMIN_USER_IDS=
